{
  "name": "ccc-incognito-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "dev": "pnpm build:stealth && pnpm --parallel --filter @ckb-ccc/stealth --filter @ccc-incognito/demo dev",
    "build": "pnpm build:demo",
    "build:demo": "pnpm --filter @ccc-incognito/demo build",
    "build:stealth": "pnpm --filter @ckb-ccc/stealth build",
    "test:stealth": "pnpm --filter @ckb-ccc/stealth test",
    "test": "pnpm test:structure && pnpm test:stealth && pnpm test:demo",
    "test:structure": "node scripts/check-workspace.mjs",
    "test:demo": "pnpm --filter @ccc-incognito/demo test:demo",
    "typecheck": "pnpm build:stealth && pnpm --filter @ccc-incognito/demo typecheck",
    "preview": "pnpm --filter @ccc-incognito/demo preview",
    "capture:evidence": "pnpm --filter @ccc-incognito/demo capture:evidence",
    "diagram:export": "pnpm --filter @ccc-incognito/demo diagram:export"
  },
  "devDependencies": { "typescript": "^5.9.3" }
}
